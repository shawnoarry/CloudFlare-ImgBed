{
  "name": "cloudflare-imgbed",
  "version": "2.7.5",
  "private": true,
  "type": "module",
  "workspaces": [
    "deploy/profiles/*"
  ],
  "scripts": {
    "ci-test": "concurrently --kill-others \"npm start\" \"wait-on http://localhost:8080 && npm test\"",
    "ci-test:docker": "concurrently --kill-others \"npm run start:docker\" \"wait-on http://localhost:8080 && npm test\"",
    "test": "node --test",
    "start": "npx wrangler pages dev ./frontend-dist --kv \"img_url\" --r2 \"img_r2\" --ip 0.0.0.0 --port 8080 --persist-to ./data",
    "start:docker": "node --import ./deploy/server/register.mjs deploy/server/index.js",
    "deploy:worker": "node deploy/worker/generate-routes.js && npx wrangler deploy --config deploy/worker/wrangler.toml"
  },
  "overrides": {
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "miniflare": "5.20260804.0-alpha",
    "wait-on": "^7.2.0",
    "wrangler": "^4.120.1"
  }
}
